# =====================================================================
# EVOLUTION API — variables de entorno
# Copiar a /opt/evolution/.env y completar. NUNCA al control de versiones.
# =====================================================================

SERVER_URL=http://127.0.0.1:8080

# --- Autenticación ----------------------------------------------------
# Llave maestra de la API. Da control total sobre el WhatsApp del negocio:
# quien la tenga puede leer y enviar mensajes en nombre de Pedro.
# Generar con:  openssl rand -hex 32
AUTHENTICATION_API_KEY=

# --- Licencia ---------------------------------------------------------
# NO HACE FALTA EN v2.3.7: la activación se introdujo en la 2.4.0, que aún no
# tiene versión estable (CLAUDE.md §1.3). Se deja aquí, vacía y documentada,
# para el día que haya que subir.
#
# Cuando llegue ese día: autoactivación headless. Requisito imprescindible —
# este correo tiene que haberse registrado UNA VEZ a mano en el Manager.
# Sin ese primer registro la variable no sirve de nada y el contenedor
# recreado queda en 503, es decir, con el WhatsApp del negocio caído.
# Si la autoactivación falla, cae al flujo manual sin abortar el arranque.
EVOLUTION_OPERATOR_EMAIL=

# --- Base de datos ----------------------------------------------------
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
POSTGRES_USER=evolution
POSTGRES_PASSWORD=
DATABASE_CONNECTION_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=pedro

# Qué se guarda en base. Los mensajes se guardan porque Chatwoot los ingesta
# desde aquí; el historial de largo plazo vive en Chatwoot, no aquí.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# --- Redis ------------------------------------------------------------
REDIS_PASSWORD=
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:${REDIS_PASSWORD}@redis:6379/0
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# --- Integración nativa con Chatwoot ----------------------------------
# El puente que evita escribirlo a mano (CLAUDE.md §1.1). Los datos de la
# cuenta y el token se configuran POR INSTANCIA al crearla, no aquí: aquí
# solo se habilita la función.
CHATWOOT_ENABLED=true
CHATWOOT_MESSAGE_READ=true
CHATWOOT_MESSAGE_DELETE=false
# Chatwoot guarda su propio estado de la conversación en su Postgres.
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=

# --- Sesión de WhatsApp -----------------------------------------------
CONFIG_SESSION_PHONE_CLIENT=Pedro Abogado
CONFIG_SESSION_PHONE_NAME=Chrome

# Reconexión automática al arrancar: sin esto, un reinicio del contenedor
# deja la instancia creada pero desconectada hasta que alguien la toque.
DEL_INSTANCE=false

# --- Webhooks ---------------------------------------------------------
# Se dejan apagados. En la Etapa 2 no hay IA: los mensajes van de Evolution a
# Chatwoot por la integración nativa y ahí se quedan. El webhook hacia el
# motor se enciende en la Etapa 4, y hacia Chatwoot, no hacia Evolution
# (ADR-001).
WEBHOOK_GLOBAL_ENABLED=false

# --- Registro ---------------------------------------------------------
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
# Nunca a DEBUG en producción: Baileys escribe el contenido de los mensajes
# en el log, y eso es material bajo secreto profesional.

# --- Telemetría -------------------------------------------------------
TELEMETRY=false
