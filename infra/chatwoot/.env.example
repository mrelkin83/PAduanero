# =====================================================================
# CHATWOOT — variables de entorno
# Copiar a /opt/chatwoot/.env y completar. NUNCA al control de versiones.
#
# La lista completa está en
# https://developers.chatwoot.com/self-hosted/configuration/environment-variables
# Aquí va lo que este despliegue necesita y por qué.
# =====================================================================

# --- Identidad y secretos --------------------------------------------
# Generar con:  docker compose run --rm rails bundle exec rails secret
# Cambiarlo después invalida todas las sesiones y, peor, deja ilegibles los
# tokens de canal cifrados: habría que reconectar Instagram y Messenger.
SECRET_KEY_BASE=

# URL pública. Tiene que coincidir EXACTAMENTE con el dominio del
# certificado, incluido el esquema y sin barra final. Si no coincide, el
# widget web falla por CORS y los enlaces de los correos apuntan a un sitio
# que no existe.
FRONTEND_URL=https://chat.pedroabogadoaduanero.com

# --- Base de datos ----------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot

# --- Redis ------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# --- Correo -----------------------------------------------------------
# «Alertas por correo» del alcance de la Etapa 2. Sin esto Pedro no se entera
# de que llegó un mensaje si no tiene la pestaña abierta, que es justo lo que
# esta etapa viene a resolver.
MAILER_SENDER_EMAIL=Pedro Abogado <notificaciones@pedroabogadoaduanero.com>
SMTP_DOMAIN=pedroabogadoaduanero.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Almacenamiento ---------------------------------------------------
# Local: los adjuntos van al volumen `almacenamiento` y entran en el respaldo
# diario. Pasar a S3 solo si el volumen se vuelve un problema.
ACTIVE_STORAGE_SERVICE=local

# --- Cerrar el registro público ---------------------------------------
# CRÍTICO. Por defecto Chatwoot permite que cualquiera con la URL se cree una
# cuenta. En una bandeja con expedientes bajo secreto profesional eso no es
# una preferencia, es una brecha. Se apaga tras crear la cuenta de Pedro.
ENABLE_ACCOUNT_SIGNUP=false

# --- Operación --------------------------------------------------------
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Idioma por defecto de la interfaz y de los correos al cliente.
DEFAULT_LOCALE=es

# --- Telemetría -------------------------------------------------------
# Se apaga: la instalación maneja datos de clientes bajo secreto profesional
# y no hay motivo para mandar métricas de uso a terceros.
ENABLE_RACK_ATTACK=true
DISABLE_TELEMETRY=true
