# =====================================================================
# PEDRO ABOGADO — Variables de entorno
# Copiar a .env y completar. .env NUNCA va al control de versiones.
#
# Regla: aquí solo lo que se necesita para ARRANCAR y conectar.
# Todo parámetro operativo (precios, plazos, textos) vive en la tabla
# `configuraciones` y se edita desde el panel, no aquí.
# =====================================================================

APP_ENV=produccion              # produccion | pruebas
APP_URL=https://pedroabogadoaduanero.com
APP_ZONA_HORARIA=America/Bogota
APP_DEBUG=false

# --- Claves de cifrado ------------------------------------------------
# Ambas: 32 bytes en base64. Generar con:  openssl rand -base64 32
# Sin cualquiera de las dos, la aplicación NO arranca.
# GUARDAR COPIA FUERA DEL SERVIDOR (docs/RESPALDOS.md §4, las tres copias).

# Cifra `credenciales`, `nit_cifrado` y `totp_secret_cifrado`.
# Si se pierde, esas columnas son irrecuperables. SÍ se puede rotar con
# Credenciales::rotarClaveMaestra(), que re-cifra y sube `key_version`.
MASTER_KEY=

# Pepper del HMAC-SHA256 de `contactos.telefono_hash`.
# NO ROTA NUNCA: un hash no es reversible, así que cambiarlo dejaría todos
# los hashes existentes huérfanos y la búsqueda por teléfono fallaría en
# silencio. Tampoco se deriva de MASTER_KEY, por esa misma razón.
PEPPER_TELEFONO=

# --- Base de datos ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pedro_aduanero
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# --- Chatwoot ---------------------------------------------------------
# La bandeja omnicanal. El bot responde SIEMPRE a través de aquí.
CHATWOOT_URL=https://chat.pedroabogadoaduanero.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=
# Token del agent bot. Se guarda cifrado desde el panel; esto es solo
# para el arranque inicial, antes de que exista el panel.
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
# Agente de Pedro en Chatwoot: a quién se le asignan los escalamientos.
# Se ve en la URL al abrir su ficha en Configuración → Agentes.
# Si se deja vacío, el escalamiento ocurre igual pero sin asignar — peor
# atendido, no perdido.
CHATWOOT_AGENTE_ABOGADO_ID=

# --- Evolution API ----------------------------------------------------
# Solo para alertas internas al abogado. Los mensajes a clientes van por Chatwoot.
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=pedro
EVOLUTION_API_KEY=
# Autoactivación headless de la licencia gratuita (evita que un reinicio
# no supervisado deje el WhatsApp caído esperando el Manager).
EVOLUTION_OPERATOR_EMAIL=

# --- Sesiones y seguridad --------------------------------------------
SESSION_NOMBRE=pa_sesion
SESSION_DURACION_MIN=120
PANEL_HOST=panel.pedroabogadoaduanero.com
# Opcional: IPs autorizadas para el panel, separadas por coma.
PANEL_IPS_PERMITIDAS=

# --- Correo -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_DESDE=notificaciones@pedroabogadoaduanero.com

# --- Logs -------------------------------------------------------------
LOG_RUTA=/var/log/pedro/app.log
LOG_NIVEL=info                  # debug | info | warn | error

# --- Respaldos y alertas ---------------------------------------------
# Clave PÚBLICA de age: el servidor cifra pero no puede descifrar. La clave
# privada NO vive aquí (docs/RESPALDOS.md §4). Sin esto, respaldo.sh aborta.
AGE_CLAVE_PUBLICA=

# Número que recibe TODAS las alertas internas, E.164 sin '+':
# salud.sh, respaldo.sh, escalamientos urgentes del motor y modelo primario
# retirado.
#
# DEBE ser distinto del WhatsApp del negocio, por dos razones que apuntan al
# mismo sitio: si el negocio se cae, la alerta tiene que llegar por un canal
# que siga vivo; y un aviso interno en la bandeja de clientes parece un
# mensaje del despacho.
ALERTA_WHATSAPP=
