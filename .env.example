# =====================================================================
# PEDRO ABOGADO — Variables de entorno
# Copiar a .env y completar. .env NUNCA va al control de versiones.
#
# Regla: aquí solo lo que se necesita para ARRANCAR y conectar.
# Todo parámetro operativo (precios, plazos, textos) vive en la tabla
# `configuraciones` y se edita desde el panel, no aquí.
# =====================================================================

APP_ENV=produccion              # produccion | pruebas
APP_URL=https://pedroabogadoaduanero.com
APP_ZONA_HORARIA=America/Bogota
APP_DEBUG=false

# --- Clave maestra de cifrado -----------------------------------------
# 32 bytes en base64. Generar con:  openssl rand -base64 32
# Si no está definida, la aplicación NO arranca.
# GUARDAR UNA COPIA FUERA DEL SERVIDOR: si se pierde, se pierden todas
# las credenciales cifradas de la tabla `credenciales`.
MASTER_KEY=

# --- Base de datos ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pedro_aduanero
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# --- Chatwoot ---------------------------------------------------------
# La bandeja omnicanal. El bot responde SIEMPRE a través de aquí.
CHATWOOT_URL=https://chat.pedroabogadoaduanero.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=
# Token del agent bot. Se guarda cifrado desde el panel; esto es solo
# para el arranque inicial, antes de que exista el panel.
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# --- Evolution API ----------------------------------------------------
# Solo para alertas internas al abogado. Los mensajes a clientes van por Chatwoot.
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=pedro
EVOLUTION_API_KEY=
# Autoactivación headless de la licencia gratuita (evita que un reinicio
# no supervisado deje el WhatsApp caído esperando el Manager).
EVOLUTION_OPERATOR_EMAIL=

# --- Sesiones y seguridad --------------------------------------------
SESSION_NOMBRE=pa_sesion
SESSION_DURACION_MIN=120
PANEL_HOST=panel.pedroabogadoaduanero.com
# Opcional: IPs autorizadas para el panel, separadas por coma.
PANEL_IPS_PERMITIDAS=

# --- Correo -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_DESDE=notificaciones@pedroabogadoaduanero.com

# --- Logs -------------------------------------------------------------
LOG_RUTA=/var/log/pedro/app.log
LOG_NIVEL=info                  # debug | info | warn | error
