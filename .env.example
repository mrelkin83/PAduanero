# =====================================================================
# PEDRO ABOGADO — Variables de entorno
# Copiar a .env y completar. .env NUNCA va al control de versiones.
#
# Regla: aquí solo lo que se necesita para ARRANCAR y conectar.
# Todo parámetro operativo (precios, plazos, textos) vive en la tabla
# `configuraciones` y se edita desde el panel, no aquí.
# =====================================================================

APP_ENV=produccion              # produccion | pruebas
APP_URL=https://pedroabogadoaduanero.com
APP_ZONA_HORARIA=America/Bogota
APP_DEBUG=false

# --- Claves de cifrado ------------------------------------------------
# Ambas: 32 bytes en base64. Generar con:  openssl rand -base64 32
# Sin cualquiera de las dos, la aplicación NO arranca.
# GUARDAR COPIA FUERA DEL SERVIDOR (docs/RESPALDOS.md §4, las tres copias).

# Cifra `usuarios.totp_secret_cifrado`. Cifraba también las credenciales de
# proveedores y el NIT de los contactos; las dos cosas se retiraron con el
# motor y la pasarela, pero la llave sigue siendo obligatoria: sin ella
# nadie puede volver a validar un segundo factor.
MASTER_KEY=

# --- Base de datos ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pedro_aduanero
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# --- Sesiones y seguridad --------------------------------------------
SESSION_NOMBRE=pa_sesion
SESSION_DURACION_MIN=120
PANEL_HOST=panel.pedroabogadoaduanero.com
# Opcional: IPs autorizadas para el panel, separadas por coma.
PANEL_IPS_PERMITIDAS=

# --- Motor de WhatsApp (Evolution API) -------------------------------
# Prellenan la pantalla /panel/whatsapp mientras no se haya guardado nada;
# lo que vale es lo guardado en `wa_config`. La API Key NO va aquí: es
# secreta, se pega una vez en el panel (o con bin/wa-configurar.php) y se
# guarda cifrada (ADR-011). En producción Evolution corre en el mismo VPS.
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCIA=pedro

# --- Correo -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_DESDE=notificaciones@pedroabogadoaduanero.com

# --- Logs -------------------------------------------------------------
LOG_RUTA=/var/log/pedro/app.log
LOG_NIVEL=info                  # debug | info | warn | error

# --- Respaldos y alertas ---------------------------------------------
# Clave PÚBLICA de age: el servidor cifra pero no puede descifrar. La clave
# privada NO vive aquí (docs/RESPALDOS.md §4). Sin esto, respaldo.sh aborta.
AGE_CLAVE_PUBLICA=

# Número que recibe TODAS las alertas internas, E.164 sin '+':
# salud.sh, respaldo.sh, escalamientos urgentes del motor y modelo primario
# retirado.
#
# DEBE ser distinto del WhatsApp del negocio, por dos razones que apuntan al
# mismo sitio: si el negocio se cae, la alerta tiene que llegar por un canal
# que siga vivo; y un aviso interno en la bandeja de clientes parece un
# mensaje del despacho.
ALERTA_WHATSAPP=
