# Entorno de las pruebas. Copiar a .env.pruebas.
#
# DB_NAME DEBE terminar en «_pruebas»: tests/arranque.php aborta si no, y las
# pruebas de integración truncan tablas. Apuntarlas a producción borraría los
# casos reales.
#
#   mysql -u root -p -e "CREATE DATABASE pedro_pruebas
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;"

APP_ENV=pruebas
APP_URL=http://localhost
APP_DEBUG=true

# Claves de juguete, deterministas a propósito: una clave aleatoria por
# corrida haría irreproducible cualquier fallo de cifrado.
# NUNCA usar estos valores fuera de las pruebas.
MASTER_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
PEPPER_TELEFONO=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pedro_pruebas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

LOG_RUTA=storage/logs/pruebas.log
LOG_NIVEL=error
