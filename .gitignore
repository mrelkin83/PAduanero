# Secretos. El .env contiene MASTER_KEY y PEPPER_TELEFONO: si esto falla,
# se filtran todas las credenciales del sistema.
.env
.env.*
!.env.example
!.env.pruebas.example

/vendor/
/node_modules/

# storage/ se reconstruye; solo se versionan los directorios vacíos.
/storage/logs/*
/storage/cache/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
/storage/config.sentinel

/public/css/app.css
/public/build/

# PHPUnit 11 usa un directorio, no el .phpunit.result.cache de la 10.
/.phpunit.cache/
.phpunit.result.cache
/tests/cobertura/

.idea/
.vscode/
Thumbs.db
desktop.ini
