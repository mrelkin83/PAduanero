# Secretos. El .env contiene MASTER_KEY y PEPPER_TELEFONO: si esto falla,
# se filtran todas las credenciales del sistema.
.env
.env.*
!.env.example
!.env.pruebas.example

# Los .env de Chatwoot y Evolution llevan SECRET_KEY_BASE, la llave de la API
# de WhatsApp y las contraseñas de SMTP. Solo se versionan las plantillas.
/infra/*/.env

/vendor/
/node_modules/

# Respaldos locales en la raíz. El dump trae datos reales (usuarios, bitácora,
# sesiones) y el zip pesa 52 MB: jamás al repositorio. Las migraciones de
# db/migraciones/ NO caen aquí: el patrón solo cubre la raíz.
/*.sql
/*.zip

# La media de WhatsApp (notas de voz, fotos, comprobantes) son datos
# personales de los clientes. El QR de vinculación es efímero.
/storage/wa/
/storage/qr-whatsapp.png

# storage/ se reconstruye; solo se versionan los directorios vacíos.
/storage/logs/*
/storage/cache/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
/storage/config.sentinel
/storage/landing.sentinel
/storage/capturas/

# app.css SÍ se versiona: va incrustado en el HTML y el despliegue no corre
# npm. Ver docs/RUNBOOK.md §5.
/public/build/

# PHPUnit 11 usa un directorio, no el .phpunit.result.cache de la 10.
/.phpunit.cache/
.phpunit.result.cache
/tests/cobertura/

.idea/
.vscode/
Thumbs.db
desktop.ini

# Credenciales OAuth descargadas de Google Cloud: jamas al repo
client_secret_*.json
